    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^15.2.1",
    "@tonconnect/ui-react": "^2.1.0",
    "@twa-dev/sdk": "^8.0.2",
    "@types/leaflet": "^1.9.17",
    "@types/mapbox-gl": "^3.4.1",
    "@types/telegram-web-app": "^7.10.1",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "buffer": "^6.0.3",
    "eruda": "^3.4.3",
    "framer-motion": "^12.23.6",
    "leaflet": "^1.9.4",
    "leaflet-pulse-icon": "^0.1.0",
    "mapbox-gl": "^3.11.1",
